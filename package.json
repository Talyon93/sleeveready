{
  "name": "sleeveready",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/generate-seo-pages.ts",
    "dev": "tsx --env-file-if-exists=.env.local server/index.ts",
    "prebuild": "tsx scripts/generate-seo-pages.ts",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "postbuild": "tsx scripts/write-app-loader.ts && tsx scripts/generate-card-pages.ts",
    "start": "tsx --env-file-if-exists=.env.local server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "test": "tsx --env-file-if-exists=.env.local --test tests/*.test.ts",
    "test:ui": "tsx tests/browser.mjs",
    "test:ui:live": "node tests/live-browser.mjs",
    "refresh:sets": "tsx scripts/refresh-releases.ts",
    "refresh:set-icons": "tsx scripts/refresh-set-icons.ts",
    "refresh:seo-sets": "tsx scripts/refresh-seo-sets.ts",
    "refresh:card-index": "tsx scripts/refresh-card-index.ts"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.3",
    "@netlify/functions": "^6.0.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@supabase/supabase-js": "^2.57.4",
    "express": "^5.1.0",
    "jpeg-js": "^0.4.4",
    "jspdf": "^3.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "serverless-http": "^4.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@dprint/typescript": "0.101.0",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.51.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dprint": "0.64.3",
    "dprint-plugin-malva": "0.16.1",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.0"
  }
}
