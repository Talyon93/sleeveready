CARDTRADER_API_TOKEN=
PORT=3000
# Public account and saved-deck persistence (safe to expose to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Required in production: the single public origin, e.g. https://proxy.example.com
PUBLIC_APP_ORIGIN=
# TODO before public launch: identify the controller and a reachable privacy contact.
PUBLIC_PRIVACY_CONTROLLER=
PUBLIC_PRIVACY_CONTACT_EMAIL=
# Partner ids for shop links (public: they appear in the links). Empty = plain searches.
# Amazon Associates: one tag per store (amazon.com for English pages).
VITE_AMAZON_TAG_COM=
VITE_AMAZON_TAG_UK=
VITE_AMAZON_TAG_IT=
VITE_AMAZON_TAG_DE=
VITE_AMAZON_TAG_FR=
VITE_AMAZON_TAG_ES=
# eBay Partner Network campaign id (campid); the site rotation ids are built in.
VITE_EBAY_CAMPAIGN_ID=
# Optional, for later: TCGplayer partner (Impact) slug, links become https://partner.tcgplayer.com/<slug>?u=<search>
VITE_TCGPLAYER_PARTNER=
# Optional, for later: CardTrader extra query parameters for its search links, e.g. share_code=XXXX
VITE_CARDTRADER_PARAMS=
